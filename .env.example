# LLM provider (OpenAI-compatible). Groq free tier or OpenRouter both work.
#   Groq:       base url https://api.groq.com/openai/v1   -> key from console.groq.com
#   OpenRouter: base url https://openrouter.ai/api/v1      -> key from openrouter.ai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Vision-capable model used ONLY for bounded level-2 image captchas.
# Groq free tier is text-only; for vision use OpenRouter (e.g. qwen/qwen-2.5-vl-72b-instruct:free)
# or any OpenAI-compatible vision endpoint.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Browser profile directory (kept warm so login sessions persist).
# Defaults to ./profiles/<name> if unset.
BROWSER_PROFILE_DIR=

# Headed browser channel: "chrome" uses installed Google Chrome; fall back to
# bundled chromium if unset/not found.
BROWSER_CHANNEL=chrome

# Cap on how many level-2 vision captcha attempts are tried before human handoff.
CAPTCHA_VISION_ATTEMPTS=3

# Paid captcha solving, used only when a board enforces a bot check on
# submit (e.g. Greenhouse's reCAPTCHA, which is verified server-side).
# Providers are tried in this order; only ones with a key present are used.
#   capsolver: cheaper, typically stronger on reCAPTCHA Enterprise/invisible
#             sign up at capsolver.com and top up a few dollars
#   2captcha: the long-standing fallback, human workers for hard cases
#             sign up at 2captcha.com and top up a few dollars
# Without any key set, such boards hand the final click to a human instead.
CAPTCHA_SOLVER=capsolver,2captcha
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
# Single-provider shorthand: applies only when CAPTCHA_SOLVER names exactly
# one provider (e.g. CAPTCHA_SOLVER=2captcha). Provider-specific keys win.
CAPTCHA_API_KEY=
# Milliseconds between polls while a solve is in flight.
CAPTCHA_POLL_MS=5000
# Milliseconds a single solve may take before the next provider is tried.
CAPTCHA_TIMEOUT_MS=240000

# Telegram review gate — approve an application from your phone instead of
# sitting at the terminal. Create a bot with @BotFather, then message it once
# and read your id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# When both values are set, the run sends the review summary to Telegram and
# waits for your reply; when they are absent it falls back to the terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How long to wait for your go before giving up (default 6 hours — a shift).
TELEGRAM_GATE_TIMEOUT_MS=21600000

# Voice-note transcription for Telegram replies. Groq's audio endpoint serves
# whisper-large-v3 and is OpenAI-compatible; AUDIO_API_KEY falls back to
# LLM_API_KEY when unset.
AUDIO_BASE_URL=https://api.groq.com/openai/v1
AUDIO_API_KEY=
AUDIO_MODEL=whisper-large-v3

# Daily per-board submission cap (sanity throttle).
DAILY_SUBMIT_CAP=5